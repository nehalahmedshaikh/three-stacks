.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# built third-party checkers/solvers (see docs/building.md)
tools/
drat-trim/
cadical/

# scratch sweeps; the minimal ones are promoted into results/basis_found.json
# by scripts/promote_witnesses.py, and the certified ones live in claims.json
results/witnesses.jsonl

# reports produced by verify_basis.py for permutations this repo does not
# claim; the hash suffix keeps them from overwriting the committed ones
results/basis_k*_n*_*.json

# Certificates are large and fully regenerable:
#   python scripts/certify.py --perm <perm> --k 3
# The four shortest pairs (21, 22, 23, 24) are committed, so a reader can
# check the headline claim without running a solver first.  Everything else is
# ignored and regenerates from the permutation.
proofs/*.cnf
proofs/*.drat
!proofs/k3_n21_39ee15ca.cnf
!proofs/k3_n21_39ee15ca.drat
!proofs/k3_n22_332bfe43.cnf
!proofs/k3_n22_332bfe43.drat
!proofs/k3_n23_4a24b696.cnf
!proofs/k3_n23_4a24b696.drat
!proofs/k3_n24_3a74bbc0.cnf
!proofs/k3_n24_3a74bbc0.drat

# detached search logs
logs/
